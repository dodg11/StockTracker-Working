<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/dark_card"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Мониторинг"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <Switch
                    android:id="@+id/switchNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/notifications_enabled"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monitoring_interval"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seekInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="58"
                    android:progress="4"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvIntervalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 минут"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_drop_threshold"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seekDropThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="48"
                    android:progress="4"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDropThresholdValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5%"
                    android:textColor="@color/red"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnStartMonitoring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_monitoring"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnStopMonitoring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop_monitoring"
            android:backgroundTint="@color/red"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tvMonitoringStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Статус: остановлен"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvLastUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Последнее обновление: —"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
